# Normalize line endings: LF in the repository, native in working trees.
* text=auto eol=lf

# Binary assets — never touch.
*.png    binary
*.pdf    binary
*.whl    binary
*.bcfzip binary
*.zip    binary

# IFC is text (ISO 10303-21) but the evaluation models are kept byte-exact,
# so they are excluded from line-ending normalization.
*.ifc    -text
